# Copy to .env and adjust. No working credentials here — placeholders only.

POSTGRES_DB=adloop
POSTGRES_USER=adloop
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://adloop:changeme@db:5432/adloop

WEB_PORT=3000

MINIO_ROOT_USER=adloop-minio
MINIO_ROOT_PASSWORD=changeme-minio
S3_ENDPOINT=http://minio:9000
S3_BUCKET=adloop
S3_REGION=us-east-1

SESSION_SECRET=replace-with-at-least-32-random-characters
# Development only. Set to disabled before deploying; mail delivery is outside Etappe 2.
AUTH_CODE_DELIVERY=log
# Configure all four together to enable live Meta OAuth:
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
# ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v25.0
SYNC_BACKFILL_DAYS=180

# Etappe 4 — private playbooks (mounted at runtime, not in the Docker build context)
# PLAYBOOK_DIR=/var/adloop/playbooks
# ANTHROPIC_API_KEY=
# PLAYBOOK_EXPORT_ENABLED=false

JOB_POLL_INTERVAL_MS=1000
JOB_LEASE_MS=10000
JOB_HEARTBEAT_INTERVAL_MS=3000
WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_GRACE_MS=8000
