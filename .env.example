# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in your values. .env is gitignored.
# NEVER put real keys into this file.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key for the LLM stages (Strategist/Copywriter/Critic/…).
# Source: https://console.anthropic.com/ → Settings → API Keys.
ANTHROPIC_API_KEY=

# Firecrawl API key for Scout/onboarding (scrape + search).
# Source: https://www.firecrawl.dev/ → Dashboard → API Keys.
FIRECRAWL_API_KEY=

# fal.ai key for static creative generation (Designer stage).
# Source: https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs key for the audio briefing (roadmap feature; optional).
# Source: https://elevenlabs.io/ → Profile → API Keys.
ELEVENLABS_API_KEY=

# Meta Graph API access token (system-user token recommended) for
# connectors/meta.ts.
# Source: https://business.facebook.com/ → Business settings → System users
# → Generate token (scopes: ads_management, ads_read).
META_ACCESS_TOKEN=

# Meta ad account ID, ONLY the number without the "act_" prefix
# (the code adds the prefix itself).
# Source: Meta Ads Manager → account overview (or the act=… URL parameter).
META_AD_ACCOUNT_ID=

# Model routing per pipeline stage (practical learning: the best reasoning
# model is not necessarily the best copy model). Values are Anthropic model IDs.
# Strategist/Critic: best reasoning model, if latency is acceptable.
MODEL_STRATEGIST=claude-fable-5

# Copywriter / pipeline speed.
MODEL_COPY=claude-sonnet-5

# fal.ai model for statics; switchable via env (fallback: an endpoint with
# stronger text rendering if text-in-image quality is weak).
# Source: https://fal.ai/models (model ID from the model page).
FAL_MODEL_ID=fal-ai/nano-banana-pro

# n8n public API key (cloud instance) for the optimize scheduler.
N8N_API_KEY=

# Render API key for the showcase/demo deployment (optional).
RENDER_API_KEY=

# Shared secret: guards mutation routes (publish/optimize/approve) in public
# deployments. Without the correct header, only read routes are open.
ADLOOP_ADMIN_SECRET=

# Default brand for Mission Control (slug). Without a value: the versioned
# demo brand "creators-demo" (real brands live only locally under brands/).
NEXT_PUBLIC_DEFAULT_BRAND=
