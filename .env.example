# ─────────────────────────────────────────────────────────────────────────────
# Env-Vars laut SPEC.md §5 — Kopie als .env anlegen und Werte eintragen.
# .env ist gitignored. NIEMALS echte Keys in diese Datei schreiben.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API-Key für das LLM (Strategist/Copywriter/Critic/…).
# Quelle: https://console.anthropic.com/ → Settings → API Keys (Linus' Account).
ANTHROPIC_API_KEY=

# Firecrawl API-Key für Scout/Onboarding (scrape + search).
# Quelle: https://www.firecrawl.dev/ → Dashboard → API Keys.
FIRECRAWL_API_KEY=

# Fal.ai Key für die Static-Generierung (Designer-Stufe).
# Quelle: https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs Key für das Audio-Briefing (ein TTS-Call, Nice-to-have).
# Quelle: https://elevenlabs.io/ → Profil → API Keys.
ELEVENLABS_API_KEY=

# Meta Graph-API Access-Token (System-User-Token empfohlen) für den
# Code-Pfad connectors/meta.ts (Fallback zum Meta Ads MCP).
# Quelle: https://business.facebook.com/ → Business-Einstellungen → System-User
# → Token generieren (Scopes: ads_management, ads_read).
META_ACCESS_TOKEN=

# Meta Ad-Account-ID, NUR die Zahl ohne "act_"-Präfix (der Code prefixt selbst).
# Quelle: Meta Ads Manager → Konto-Übersicht (oder URL-Parameter act=…).
META_AD_ACCOUNT_ID=

# Model-Routing pro Pipeline-Stufe (Praxis-Learning: bestes Reasoning-Modell
# ≠ bestes Copy-Modell). Werte sind Anthropic-Model-IDs.
# Strategist/Critic: bestes Reasoning, wenn Latenz okay.
MODEL_STRATEGIST=claude-fable-5

# Copywriter/Pipeline-Speed.
MODEL_COPY=claude-sonnet-5

# Fal-Modell für Statics; per Env switchbar (Fallback laut SPEC §8:
# GPT-Image-2-Endpoint, falls Text-im-Bild schwächelt).
# Quelle: https://fal.ai/models (Model-ID aus der Modell-Seite).
FAL_MODEL_ID=fal-ai/nano-banana-pro

# n8n Public-API-Key (Cloud-Instanz), fuer den Optimize-Scheduler.
N8N_API_KEY=

# Render API-Key fuer das Showcase-/Demo-Deployment.
RENDER_API_KEY=

# Shared Secret: schuetzt Mutations-Routen (publish/optimize/approve) im
# oeffentlichen Deployment. Ohne korrekten Header sind nur Read-Routen offen.
ADLOOP_ADMIN_SECRET=
