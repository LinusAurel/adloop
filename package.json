{
  "name": "adloop-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/worker.js",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/migrate.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "next": "15.1.4",
    "node-pg-migrate": "7.9.1",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "uuidv7": "1.0.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "10.16.0",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "esbuild": "0.24.2",
    "lefthook": "^2.1.10",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
