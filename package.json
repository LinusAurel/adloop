{
  "name": "adloop-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/worker.js",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/migrate.js",
    "worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:meta-contract": "vitest run --config vitest.meta-contract.config.ts",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "next": "15.5.22",
    "node-pg-migrate": "9.0.0",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "uuidv7": "1.0.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "26.1.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "esbuild": "0.28.1",
    "lefthook": "^2.1.10",
    "testcontainers": "12.0.4",
    "typescript": "5.7.2",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  }
}
